{
  "manifest_version": 3,
  "name": "G-Rater",
  "version": "0.8.2",
  "description": "Save rubrics for G-Scope and review prepared grading suggestions. No AI connector or pairing required.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "G-Rater",
    "default_icon": {
      "16": "icons/icon-16.png",
      "20": "icons/icon-20.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "analyze-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Show the saved G-Scope suggestion"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; img-src 'self' data:"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "20": "icons/icon-20.png",
    "24": "icons/icon-24.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}

{
  "manifest_version": 3,
  "name": "G-Report",
  "version": "0.2.4",
  "description": "Fill the Rutgers final integrity reporting form from a locally selected Casebook JSON file. Never submits.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "G-Report",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "20": "icons/icon-20.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:*"
  },
  "optional_host_permissions": [
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "20": "icons/icon-20.png",
    "24": "icons/icon-24.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}

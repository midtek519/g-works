%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Course description
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\SyllabusCourseDescription}{%
  \SyllabusItem{Course\\Description}{%
    This course is an introduction to differential and integral calculus with emphasis on conceptual understanding, modeling, and interpretation of quantitative relationships in the life sciences. Students in other majors should take 01:640:130 or 01:640:151, as appropriate for their program.
  }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Course learning goals
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\SyllabusLearningGoals}{%
  \SyllabusItem{Course\\Learning\\Goals}{%
    By the end of this course, learners will be able to:
    \begin{enumerate}[label=\textbf{[\arabic*]},topsep=2pt,itemsep=-1ex,partopsep=1ex,parsep=1ex]
        \item Apply calculus concepts to life sciences.
        \item Articulate ideas of calculus in English.
        \item Demonstrate competence with core tasks of calculus, such as:
        \begin{itemize}[topsep=-1pt,itemsep=-1ex,partopsep=1ex,parsep=1ex]
            \item solving problems involving related rates of change
            \item describing the relationships among a function and its first two derivatives
            \item solving optimization problems
            \item estimating change using the method of linear approximation
            \item calculating area under a graph as an integral
        \end{itemize}
        \item See oneself as capable of engaging with mathematics.
    \end{enumerate}
  }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Prerequisites
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\SyllabusPrerequisites}{%
  \SyllabusItem{Prerequisites}{%
    You must have sufficient mastery of topics in intermediate algebra and precalculus. The official prerequisite for Math 135 is Precalculus (Math 115 or 111--112), or placement into Calculus I through the ALEKS placement exam.
  }%
}


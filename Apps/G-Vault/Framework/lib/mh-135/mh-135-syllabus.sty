%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Absences and makeups
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\SyllabusAbsences}{%
  \SyllabusItem{Absences \&\\Makeups}{%
    You are expected to attend all classes and take all quizzes and exams at the scheduled times.

    \begin{itemize}[itemsep=0pt,topsep=2pt]
      \item \textbf{Lectures:}
        Regular attendance is expected and crucial for your success.

      \item \textbf{Quizzes:}
        There are no makeups for quizzes for any reason. Instead, the dropped quizzes will account for absences due to minor illness and other unforeseen circumstances. You may also be excused from a quiz for religious observance.

      \item \textbf{Exams:}
        If you must miss an exam, you must notify your professor as soon as possible. A makeup exam or other arrangement can be offered only if the absence is due to a religious observance or an unavoidable, verifiable emergency.
    \end{itemize}
  }%
}


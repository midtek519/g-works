%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Final grades
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\SyllabusFinalGrades}{%
  \SyllabusItem{Final\\Grades}{%
    Your final letter grade in the course is calculated as follows:
    \begin{enumerate}[
      label=\textbf{[\arabic*]},
      topsep=4pt,
      itemsep=-1ex,
      partopsep=-1ex,
      parsep=1ex
    ]
      \item
        Your \textbf{weighted course average} is converted to a letter ($X$) using the table above.
      \item
        Your score on the final exam is converted to a letter ($Y$) using the table above.
      \item
        If $Y$ is a better grade than $X$, then your final letter grade in the course is the next highest letter above $X$. Otherwise, your final letter grade in the course is $X$.
    \end{enumerate}

    \textbf{Note:} Your \textbf{weighted course average} includes the 36\% weight of the Final Exam.

    \vi

    Here are a few examples:
    \begin{itemize}[topsep=4pt,itemsep=-1ex,partopsep=-1ex,parsep=1ex]
      \item
        \textbf{Example:} Your weighted course average is 65\% (C+) and your final exam score is 65\% (C+). Your final letter grade in the course is C+.
      \item
        \textbf{Example:} Your weighted course average is 65\% (C+) and your final exam score is 80\% (B+). Your final letter grade in the course is B.
      \item
        \textbf{Example:} Your weighted course average is 65\% (C+) and your final exam score is 60\% (C). Your final letter grade in the course is C+.
    \end{itemize}
  }%
}


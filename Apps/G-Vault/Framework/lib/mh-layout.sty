\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mh-layout}
  [2026/08/27 v0.5.0 Shared layouts for mathematics documents]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Packages                  %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{enumitem}
\RequirePackage{etoolbox}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Layout mode               %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mhlayoutmode}{document}

\DeclareOption{document}{%
  \renewcommand{\mhlayoutmode}{document}%
}

\DeclareOption{manual}{%
  \renewcommand{\mhlayoutmode}{manual}%
}

\DeclareOption{assessment}{%
  \renewcommand{\mhlayoutmode}{exam}%
}

% Temporary compatibility alias.
\DeclareOption{exam}{%
  \renewcommand{\mhlayoutmode}{exam}%
}

\DeclareOption{worksheet}{%
  \renewcommand{\mhlayoutmode}{worksheet}%
}

\DeclareOption*{%
  \PackageWarning{mh-layout}
    {Unknown layout option `\CurrentOption'}%
}

\ExecuteOptions{document}
\ProcessOptions\relax

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Document identifiers      %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\MathLeftHeader}{}
\newcommand{\MathCenterHeader}{}
\newcommand{\MathRightHeader}{}

\newcommand{\SetMathLeftHeader}[1]{%
  \renewcommand{\MathLeftHeader}{#1}%
}

\newcommand{\SetMathCenterHeader}[1]{%
  \renewcommand{\MathCenterHeader}{#1}%
}

\newcommand{\SetMathRightHeader}[1]{%
  \renewcommand{\MathRightHeader}{#1}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Universal paragraph style %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\setlength{\parindent}{0pt}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Universal running marks   %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mhLeftFooter}{\leftmark}

\newcommand{\mhSetupMarks}{%
  \renewcommand{\chaptermark}[1]{}%
  \renewcommand{\sectionmark}[1]{%
    \markboth{##1}{}%
  }%
  \renewcommand{\mhLeftFooter}{\leftmark}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Universal page style      %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mhDefinePageStyle}[1]{%
  \fancypagestyle{#1}{%
    \fancyhf{}%

    \lhead{\MathLeftHeader}%
    \chead{\MathCenterHeader}%
    \rhead{\MathRightHeader}%

    \lfoot{\mhLeftFooter}%
    \cfoot{}%
    \rfoot{Page \thepage\ of \pageref{LastPage}}%

    \renewcommand{\headrulewidth}{0.4pt}%
    \renewcommand{\footrulewidth}{0pt}%
  }%
}

\newcommand{\mhSetupPageStyle}{%
  \setlength{\headheight}{14.5pt}%

  \fancypagestyle{mhfront}{%
    \fancyhf{}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}%
  }%

  \mhDefinePageStyle{fancy}%
  \mhDefinePageStyle{plain}%

  \pagestyle{fancy}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Universal enumerate       %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mhEnumerateLabelOne}{(\alph*)}
\newcommand{\mhEnumerateLabelTwo}{(\roman*)}

\IfMathAccessibleT{%
  \renewcommand{\mhEnumerateLabelOne}{\alph*.}%
  \renewcommand{\mhEnumerateLabelTwo}{\roman*.}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% DOCUMENT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mhApplyDocumentLayout}{%
  % Paper layout
  \geometry{
    left=0.5in,
    right=0.5in,
    top=0.65in,
    bottom=0.65in
  }%

  % Enumerate level 1
  \setlist[enumerate,1]{
    label=\mhEnumerateLabelOne,
    itemsep=0pt,
    parsep=0pt,
    topsep=0.4em,
    partopsep=0pt,
    leftmargin=3em,
    rightmargin=1.5em
  }%

  % Enumerate level 2
  \setlist[enumerate,2]{
    label=\mhEnumerateLabelTwo,
    itemsep=0pt,
    parsep=0pt,
    topsep=0.2em,
    partopsep=0pt,
    leftmargin=4em,
    rightmargin=1.5em
  }%

  % Itemize
  \setlist[itemize]{
    itemsep=0.2em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    leftmargin=2em,
    rightmargin=1.5em
  }%
}


\ProvidesPackage
  {mh-templates}
  [2026/10/11 v0.6.1 Exercise and solution templates]

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Purpose
%
% Defines the visual appearance of Math exercise and solution records.
%
% This package contains presentation code only. Curriculum data,
% metadata declarations, and validation belong elsewhere.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{tcolorbox}
\tcbuselibrary{breakable,skins}
\RequirePackage{zref-savepos,zref-abspage}
\zref@addprop{savepos}{abspage}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Local equation numbering
%
% Equations display as (1), (2), ... rather than using chapter or
% section prefixes. The counter is reset by each exercise/solution
% template below; no new equation environment is required. A separate global
% group number keeps PDF destinations unique across these local resets.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\renewcommand{\theequation}{\arabic{equation}}

\newcounter{mhEquationGroup}
\let\mhOriginalEquationAnchor\theHequation
\renewcommand{\theHequation}{%
  mh.\arabic{mhEquationGroup}.\mhOriginalEquationAnchor%
}

\newcommand{\mhResetEquationNumbering}{%
  \stepcounter{mhEquationGroup}%
  \setcounter{equation}{0}%
}


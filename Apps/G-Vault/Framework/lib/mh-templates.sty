% Worksheet exercise template
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mhWorksheetWorkspaceStartName}{%
  mh-worksheet-workspace-start-\GetExerciseProperty{counter}%
}
\newcommand{\mhWorksheetWorkspaceEndName}{%
  mh-worksheet-workspace-end-\GetExerciseProperty{counter}%
}
% Workspace remains unboxed so stretch glue reaches the page builder. Draw
% each frame at shipout, using absolute page/position labels from the prior
% pass; a single remembered TikZ rectangle cannot cross page boundaries.
\newcounter{mhWorksheetWorkspaceFrame}
\newcommand{\mhWorksheetWorkspaceFrames}{}
\newcommand{\mhDrawWorksheetWorkspaceFrame}[3]{%
  \begingroup
  \edef\mhFrameStartPage{\zref@extractdefault{mh-ws-start-#1}{abspage}{0}}%
  \edef\mhFrameEndPage{\zref@extractdefault{mh-ws-end-#1}{abspage}{0}}%
  \ifnum\mhFrameStartPage>0
    \ifnum\ReadonlyShipoutCounter<\mhFrameStartPage\else
      \ifnum\ReadonlyShipoutCounter>\mhFrameEndPage\else
        \edef\mhFrameLeft{\the\dimexpr\zposx{mh-ws-start-#1}sp-2mm+0.35pt\relax}%
        \edef\mhFrameRight{\the\dimexpr\mhFrameLeft+#2-0.7pt\relax}%
        \edef\mhFrameTop{\the\dimexpr\paperheight-1in-\voffset-\topmargin-\headheight-\headsep\relax}%
        \edef\mhFrameBottom{\the\dimexpr\mhFrameTop-\textheight\relax}%
        \ifnum\ReadonlyShipoutCounter=\mhFrameStartPage
          \edef\mhFrameTop{\the\dimexpr\zposy{mh-ws-start-#1}sp+#3-0.35pt\relax}%
        \fi
        \ifnum\ReadonlyShipoutCounter=\mhFrameEndPage
          \edef\mhFrameBottom{\the\dimexpr\zposy{mh-ws-end-#1}sp+0.35pt\relax}%
        \fi
        \begin{tikzpicture}[remember picture,overlay]
          \begin{scope}[shift={(current page.south west)}]
            \draw[mhExerciseBlue,line width=0.7pt]
              (\mhFrameLeft,\mhFrameTop)--(\mhFrameLeft,\mhFrameBottom)
              (\mhFrameRight,\mhFrameTop)--(\mhFrameRight,\mhFrameBottom);
            \ifnum\ReadonlyShipoutCounter=\mhFrameStartPage
              \draw[mhExerciseBlue,line width=0.7pt]
                (\mhFrameLeft,\mhFrameTop)--(\mhFrameRight,\mhFrameTop);
            \fi
            \ifnum\ReadonlyShipoutCounter=\mhFrameEndPage
              \draw[mhExerciseBlue,line width=0.7pt]
                (\mhFrameLeft,\mhFrameBottom)--(\mhFrameRight,\mhFrameBottom);
            \fi
          \end{scope}
        \end{tikzpicture}%
      \fi
    \fi
  \fi
  \endgroup
}
\AddToHook{shipout/background}{\mhWorksheetWorkspaceFrames}
\newcommand{\mhWorksheetWorkspaceStart}{%
  \par\addvspace{10pt plus 2pt}%
  \stepcounter{mhWorksheetWorkspaceFrame}%
  \edef\mhWorksheetCurrentFrame{\themhWorksheetWorkspaceFrame}%
  \xappto\mhWorksheetWorkspaceFrames{%
    \noexpand\mhDrawWorksheetWorkspaceFrame{\mhWorksheetCurrentFrame}%
      {\the\linewidth}{\the\dimexpr\ht\strutbox+2mm\relax}}%
  \begingroup
  % Balanced columns discard stretch glue. Give each student part its own
  % vertical working area when worksheet workspace is explicitly enabled.
  \RenewDocumentEnvironment{multicols}{m O{} O{\premulticols}}
    {\par ##2}{\par}%
  \RenewDocumentEnvironment{multicols*}{m O{} O{\premulticols}}
    {\par ##2}{\par}%
  \RenewDocumentCommand{\columnbreak}{O{4}}{\par}%
  \@endparpenalty=10000\relax
  \leftskip=\dimexpr 2mm+0.35pt\relax
  \rightskip=2mm
  \advance\linewidth by -4mm
  \noindent\rule{0pt}{\dimexpr\ht\strutbox+2mm\relax}%
  \makebox[0pt][l]{%
    \zsavepos{mh-ws-start-\mhWorksheetCurrentFrame}%
    \tikz[remember picture,overlay]{%
      \coordinate (\mhWorksheetWorkspaceStartName)
        at (-2mm,\dimexpr\ht\strutbox+2mm\relax);
      \node[anchor=north east,fill=mhExerciseBlue,text=white,
        font=\normalfont\normalsize\bfseries,inner xsep=2mm,inner ysep=1mm]
        at ([xshift=0.25pt,yshift=0.2pt]\mhWorksheetWorkspaceStartName)
        {\GetExerciseProperty{counter}};
    }%
  }%
}
\newcommand{\mhWorksheetWorkspaceEnd}{%
  \par\nobreak\vspace{3mm}%
  \nointerlineskip\hbox to 0pt{\zsavepos{mh-ws-end-\mhWorksheetCurrentFrame}\hss}%
  \endgroup
  \par
}

\DeclareExerciseEnvironmentTemplate{mh-worksheet}
  {
    \MathQuestionWorkspaceBegin
    \MathRegisterCurrentExercise
    \mhResetEquationNumbering
    \MathPreExerciseHeader

    \IfMathWorksheetWorkspaceTF
      {\mhWorksheetWorkspaceStart}
      {\begin{tcolorbox}[
      enhanced,
      breakable,
      colframe=mhExerciseBlue,
      colback=white,
      boxrule=0.7pt,
      sharp corners,
      boxsep=0mm,
      left=2mm,
      right=2mm,
      top=2mm,
      bottom=3mm,
      pad at break*=5pt,
      before skip=10pt plus 2pt,
      after skip=0pt,
      overlay unbroken={\mhWorksheetExerciseFlag},
      overlay first={\mhWorksheetExerciseFlag}
    ]}
  }
  {
    \MathWorksheetWorkspaceFinish
    \MathQuestionWorkspaceEnd
    \IfMathWorksheetWorkspaceTF
      {\mhWorksheetWorkspaceEnd}
      {\end{tcolorbox}}
  }


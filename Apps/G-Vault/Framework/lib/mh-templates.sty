%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Workspace exam exercise top adjustment
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mhExamWorkspaceTopAdjust}{0pt}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Workspace exam exercise start
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mhExamWorkspaceStart}{%
  \begingroup
  \leftskip=\dimexpr 2mm+0.2pt\relax
  \rightskip=2mm
  \advance\linewidth by -4mm
  \noindent
  \rule{0pt}{%
    \dimexpr
      \ht\strutbox
      +2mm
      +\mhExamWorkspaceTopAdjust
    \relax
  }%
  \makebox[0pt][l]{%
    \tikz[remember picture,overlay]{%
      \coordinate (mh-exam-workspace-baseline) at (-2mm,0);

      \coordinate (\mhExamWorkspaceStartName)
        at ([%
          yshift=\dimexpr
            \ht\strutbox
            +2mm
            +\mhExamWorkspaceTopAdjust
          \relax
        ]mh-exam-workspace-baseline);

      \node[
        anchor=north east,
        fill=white,
        draw=black,
        line width=0.5pt,
        text=black,
        font=\normalfont\normalsize\bfseries,
        text width=\dimexpr 11mm-2mm+0.2pt\relax,
        inner xsep=1mm,
        inner ysep=1mm+1.3pt,
        align=center
      ]
      at ([xshift=0.5pt, yshift=0pt]\mhExamWorkspaceStartName)
      {\strut Q\GetExerciseProperty{counter}.};

      \ifx\mhExamExercisePointFlag\mhExamExercisePointFlagYes
        \node[
          anchor=north east,
          inner sep=0pt
        ]
        at ([%
          xshift=0.5pt,
          yshift=\dimexpr
            -\ht\strutbox
            -\dp\strutbox
            -2mm
            -2.4pt
          \relax
        ]\mhExamWorkspaceStartName)
        {%
          \AssessmentExercisePointBox{\GetExerciseProperty{points}}%
        };
      \fi
    }%
  }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Workspace exam exercise end
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mhExamWorkspaceEnd}{%
  \par
  \vspace{2mm}%
  \endgroup

  % Record the lower-left corner.
  \tikz[remember picture,overlay]{%
    \coordinate (\mhExamWorkspaceEndName) at (0,0);

    % Draw only a visual frame. The exercise itself has never been boxed.
    \draw[
      gray!50,
      line width=0.5pt
    ]
      ([xshift=0.25pt,yshift=-0.25pt]\mhExamWorkspaceStartName)
      rectangle
      ([xshift=\dimexpr\linewidth-0.25pt\relax,yshift=0.25pt]\mhExamWorkspaceEndName);
  }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Exam exercise spacing
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newlength{\mhExamExerciseGap}
\setlength{\mhExamExerciseGap}{4pt}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Exam exercise state
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newif\ifmhExamWorkspaceExercise

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Exam exercise
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\DeclareExerciseEnvironmentTemplate{mh-exam}
  {
    \MathQuestionWorkspaceBegin
    \MathRegisterCurrentExercise
    \mhResetEquationNumbering
    \MathPreExerciseHeader

    % Uniform gap before every exam exercise.
    \par
    \addvspace{\mhExamExerciseGap}%

    \IfMathExamTF
      {
        \GetExercisePropertyT{points}
          {
            \AssessmentAddPoints{\PropertyValue}
          }
      }
      {}

    % Decide whether this is a workspace exercise.
    \mhExamWorkspaceExercisefalse
    \IfMathStudentT{%
      \IfExercisePropertySetTF{workspace}
        {\mhExamWorkspaceExercisetrue}
        {}%
      \IfMathQuestionWorkspaceT{\mhExamWorkspaceExercisetrue}%
    }

    % Determine any additional top clearance for a workspace exercise.
    \renewcommand{\mhExamWorkspaceTopAdjust}{0pt}
    \IfMathStudentT{%
      \IfExercisePropertySetTF{workspace-top}
        {%
          \edef\mhExamWorkspaceTopAdjust{%
            \GetExerciseProperty{workspace-top}%
          }%
        }
        {}%
    }

    % Decide whether an exercise-level point flag exists.
    \let\mhExamExercisePointFlag\mhExamExercisePointFlagNo
    \IfExercisePropertySetTF{points}
      {\let\mhExamExercisePointFlag\mhExamExercisePointFlagYes}
      {}

    \ifmhExamWorkspaceExercise
      % Workspace exercises remain visible to the page builder.
      \mhExamWorkspaceStart
    \else
      % Ordinary exercises use the normal exam box.
      \begin{tcolorbox}[
        enhanced,
        breakable,
        colframe=gray!50,
        colback=white,
        boxrule=0.5pt,
        sharp corners,
        boxsep=0mm,
        left=2mm,
        right=2mm,
        top=2mm,
        bottom=2mm,
        pad at break*=5pt,
        before skip=0pt,
        after skip=0pt,
        overlay unbroken={\mhExamExerciseFlag},
        overlay first={\mhExamExerciseFlag}
      ]
    \fi
  }
  {
    \MathQuestionWorkspaceEnd
    \ifmhExamWorkspaceExercise
      \mhExamWorkspaceEnd
    \else
      \end{tcolorbox}
    \fi
  }


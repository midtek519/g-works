%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Document exercise
%
% Boxed exercise with topic title and conditional skills strip.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\DeclareExerciseEnvironmentTemplate{mh-document}
  {
    \MathQuestionWorkspaceBegin
    \MathRegisterCurrentExercise
    \mhResetEquationNumbering
    \MathPreExerciseHeader

    \begin{tcolorbox}[
      enhanced,
      breakable,
      colframe=mhExerciseBlue,
      colback=white,
      colbacktitle=mhExerciseBlue,
      coltitle=white,
      boxrule=0.7pt,
      bottomrule=0pt,
      arc=1.5mm,
      outer arc=1.5mm,
      rounded corners=north,
      sharp corners=south,
      boxsep=0mm,
      left=0mm,
      right=0mm,
      top=0mm,
      bottom=0mm,
      pad at break*=5pt,
      toptitle=1.5mm,
      bottomtitle=1.5mm,
      lefttitle=2mm,
      righttitle=2mm,
      titlerule=0.7pt,
      before skip=10pt plus 2pt,
      after skip=0pt,
      fonttitle=\normalfont\normalsize\bfseries,
      title={%
        Ex.~\GetExerciseProperty{counter}%
        \hfill
        \MathTopicLabels{\GetExerciseProperty{topics}}%
      },
      before upper={%
        \IfExercisePropertySetTF{objectives}
          {%
            \begin{tcolorbox}[
              enhanced,
              colback=mhObjectiveBlue,
              colframe=mhExerciseBlue,
              boxrule=0pt,
              bottomrule=0.7pt,
              sharp corners,
              boxsep=0pt,
              left=2mm,
              right=2mm,
              top=1mm,
              bottom=1mm,
              width=\linewidth,
              before skip=0pt,
              after skip=0pt,
              nobeforeafter
            ]
              \color{mhObjectiveText}
              \small
              \textsc{Skills:}
              \MathObjectiveLabels{\GetExerciseProperty{objectives}}
            \end{tcolorbox}
            \par\vspace{0mm}
          }
          {%
            \par\vspace{2mm}
          }%
        \leftskip=2mm
        \rightskip=2mm
      },
      after upper={%
        \par
        \vspace{2mm}
      }
    ]
  }
  {
    \MathQuestionWorkspaceEnd
    \end{tcolorbox}
  }


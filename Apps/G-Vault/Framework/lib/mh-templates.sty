%
% Plain semantic presentation shared by all document types.
% Manuals additionally display topic and objective metadata.
% Exams additionally display and register point values.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\DeclareExerciseEnvironmentTemplate{mh-accessible}
  {
    \MathRegisterCurrentExercise
    \mhResetEquationNumbering
    \MathPreExerciseHeader

    % Register exam points.
    \IfMathExamT{%
      \GetExercisePropertyT{points}{%
        \AssessmentAddPoints{\PropertyValue}%
      }%
    }%

    \par
    \medskip
    \noindent
    \textbf{Exercise \GetExerciseProperty{counter}.}%

    % Display exam points.
    \IfMathExamT{%
      \IfExercisePropertySetTF{points}
        {%
          \hfill
          \textbf{\GetExerciseProperty{points} points}%
        }
        {}%
    }%

    % Manuals display curriculum metadata.
    \IfMathManualT{%
      \par
      \smallskip
      \noindent
      \IfExercisePropertySetTF{topics}
        {%
          \textbf{Topic:}~
          \MathTopicLabels{\GetExerciseProperty{topics}}%
        }
        {}%
      \IfExercisePropertySetTF{objectives}
        {%
          \hfill
          \textbf{Skills:}~
          \MathObjectiveLabels{\GetExerciseProperty{objectives}}%
        }
        {}%
    }%

    \par
    \smallskip
  }
  {
    \par
    \medskip
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Accessible solution
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\DeclareExerciseEnvironmentTemplate{mh-accessible-solution}
  {
    \mhResetEquationNumbering
    \MathPreSolutionHeader
    \typeout{BEGIN ACCESSIBLE SOLUTION: \GetExerciseProperty{ID}}
    \par
    \smallskip
    \noindent
    \textbf{Solution to Exercise \GetExerciseProperty{counter}.}

    \par
    \smallskip
    \typeout{ACCESSIBLE SOLUTION BODY BEGIN: \GetExerciseProperty{ID}}
  }
  {
    \par
    \medskip
    \typeout{END ACCESSIBLE SOLUTION: \GetExerciseProperty{ID}}
  }
  
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Activate templates
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\IfMathAccessibleTF
  {
    \xsimsetup{
      exercise/template=mh-accessible,
      solution/template=mh-accessible-solution
    }
  }
  {
    \IfMathExamTF
      {
        \xsimsetup{
          exercise/template=mh-exam,
          solution/template=mh-exam-solution
        }
      }
      {
        \IfMathWorksheetTF
          {
            \xsimsetup{
              exercise/template=mh-worksheet,
              solution/template=mh-worksheet-solution
            }
          }
          {
            \IfMathManualTF
              {
                \xsimsetup{
                  exercise/template=mh-manual,
                  solution/template=mh-manual-solution
                }
              }
              {
                \xsimsetup{
                  exercise/template=mh-document,
                  solution/template=mh-document-solution
                }
              }
          }
      }
  }

\endinput

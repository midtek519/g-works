        {5}  {May}
        {6}  {June}
        {7}  {July}
        {8}  {Aug.}
        {9}  {Sept.}
        {10} {Oct.}
        {11} {Nov.}
        {12} {Dec.}
      }
      {?}
  }

\cs_new:Npn \mhsyllabus_format_current_date:
  {
    \mhsyllabus_month_name:n
      {\pgfcalendarcurrentmonth}
    \c_space_tl
    \int_eval:n
      {\pgfcalendarcurrentday}
  }


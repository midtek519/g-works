\newcommand{\RecitationIntroduction}{Introduction}

\msg_new:nnn {mh-syllabus}{invalid-topic}
  {Topic~index~'#1'~must~be~an~integer~in~the~current~course~topic~list.}
\msg_new:nnn {mh-syllabus}{invalid-order}
  {Lecture~topic~order~must~contain~each~course~topic~index~exactly~once.}
\msg_new:nnn {mh-syllabus}{invalid-midterm}
  {Midterm~number~'#1'~must~be~1,~2~or~3.}
\msg_new:nnn {mh-syllabus}{unassigned-meeting}
  {Lecture~meeting~#1~has~no~assigned~topic.~Review~the~course~pacing.}
\msg_new:nnn {mh-syllabus}{missing-midterm}
  {Midterm~#1~has~no~meeting~in~this~calendar.~Review~the~course~pacing.}
\msg_new:nnn {mh-syllabus}{incomplete-setting}
  {Syllabus~setting~'#1'~is~empty.~Fill~it~in~the~selected~course~profile;
   ~use~an~explicit~TBA~for~an~unannounced~final~exam.}

\NewDocumentCommand{\ValidateSyllabusSetup}{}
  {
    \mhsemester_require_range:
    \mhsyllabus_final_defaults_apply:
    \clist_map_inline:nn
      {SemesterName,InstructorName,LectureSections,LectureDays,LecturePeriod,
       LectureRoom,FinalExamDate,FinalExamTime}
      {
        \exp_args:Nv \tl_if_empty:nT {##1}
          {\msg_fatal:nnn {mh-syllabus}{incomplete-setting}{##1}}
      }
  }

\cs_new_protected:Npn \mhsyllabus_add_topic:nnnn #1#2#3#4
  {
    \seq_gput_right:Nn \g_mhsyllabus_topic_labels_seq {#1}
    \seq_gput_right:Nn \g_mhsyllabus_topic_texts_seq {#2}
    \seq_gput_right:Nn \g_mhsyllabus_topic_titles_seq {#3}
    \seq_gput_right:Nn \g_mhsyllabus_topic_rules_seq {#4}
    \mhsyllabus_invalidate_schedule:
  }

\cs_new_protected:Npn \mhsyllabus_require_topic:n #1
  {
    \tl_set:Nx \l_tmpa_tl {#1}
    \exp_args:NnV \regex_match:nnF {\A[0-9]+\Z} \l_tmpa_tl
      {\msg_fatal:nnn {mh-syllabus}{invalid-topic}{#1}}
    \bool_if:nF
      {
        \int_compare_p:n {#1 > 0}
        && \int_compare_p:n {#1 <= \seq_count:N \g_mhsyllabus_topic_labels_seq}
      }
      {\msg_fatal:nnn {mh-syllabus}{invalid-topic}{#1}}
  }

% Map an exam to a curriculum row, not to a hardcoded civil date.
\NewDocumentCommand{\SetMidtermTopic}{mm}
  {
    \str_case:nnF {#1} {{1}{} {2}{} {3}{}}
      {\msg_fatal:nnn {mh-syllabus}{invalid-midterm}{#1}}
    \mhsyllabus_require_topic:n {#2}
    \prop_gput:Nnx \g_mhsyllabus_midterm_topics_prop {#1}{#2}
    \mhsyllabus_invalidate_schedule:
  }

\NewDocumentCommand{\ResetLectureTopicOrder}{}
  {
    \prop_gclear:N \g_mhsyllabus_meeting_topics_prop
    \mhsyllabus_invalidate_schedule:
  }
\NewDocumentCommand{\SetLectureTopicOrder}{m}
  {
    \seq_set_from_clist:Nn \l_mhsyllabus_topic_order_seq {#1}
    \int_compare:nNnF {\seq_count:N \l_mhsyllabus_topic_order_seq}
      = {\seq_count:N \g_mhsyllabus_topic_labels_seq}
      {\msg_fatal:nn {mh-syllabus}{invalid-order}}
    \seq_clear:N \l_mhsyllabus_seen_topics_seq
    \seq_map_inline:Nn \l_mhsyllabus_topic_order_seq
      {
        \mhsyllabus_require_topic:n {##1}
        \tl_set:Nx \l_tmpa_tl {\int_eval:n {##1}}
        \seq_if_in:NVTF \l_mhsyllabus_seen_topics_seq \l_tmpa_tl
          {\msg_fatal:nn {mh-syllabus}{invalid-order}}
          {\seq_put_right:NV \l_mhsyllabus_seen_topics_seq \l_tmpa_tl}
      }
    \ResetLectureTopicOrder
    \seq_map_indexed_inline:Nn \l_mhsyllabus_topic_order_seq
      {\prop_gput:Nnn \g_mhsyllabus_meeting_topics_prop {##1}{##2}}
  }
\cs_new:Npn \mhsyllabus_topic_index_for_meeting:n #1
  {
    \prop_if_in:NeTF \g_mhsyllabus_meeting_topics_prop {\int_eval:n {#1}}
      {\prop_item:Ne \g_mhsyllabus_meeting_topics_prop {\int_eval:n {#1}}}
      {\int_eval:n {#1}}
  }
\NewDocumentCommand{\SwapLectureTopics}{mm}
  {
    \mhsyllabus_require_topic:n {#1}
    \mhsyllabus_require_topic:n {#2}
    \int_set:Nn \l_mhsyllabus_first_topic_int
      {\mhsyllabus_topic_index_for_meeting:n {#1}}
    \int_set:Nn \l_mhsyllabus_second_topic_int
      {\mhsyllabus_topic_index_for_meeting:n {#2}}
    \prop_gput:Nxx \g_mhsyllabus_meeting_topics_prop
      {\int_eval:n {#1}}{\int_use:N \l_mhsyllabus_second_topic_int}
    \prop_gput:Nxx \g_mhsyllabus_meeting_topics_prop
      {\int_eval:n {#2}}{\int_use:N \l_mhsyllabus_first_topic_int}
    \mhsyllabus_invalidate_schedule:
  }
\NewDocumentCommand{\IfLectureOnDayT}{mm}
  {
    \str_case:nnF {#1}
      {
        {M}{\mhsyllabus_daycode_matches:nnT {\LectureDays}{0}{#2}}
        {T}{\mhsyllabus_daycode_matches:nnT {\LectureDays}{1}{#2}}
        {W}{\mhsyllabus_daycode_matches:nnT {\LectureDays}{2}{#2}}
        {Th}{\mhsyllabus_daycode_matches:nnT {\LectureDays}{3}{#2}}
        {F}{\mhsyllabus_daycode_matches:nnT {\LectureDays}{4}{#2}}
      }
      {\msg_fatal:nnn {mh-semester}{invalid-day}{#1}}
  }

\cs_new:Npn \mhsyllabus_midterm_date_cs:n #1
  {\int_case:nn {#1} {{1}{MidtermOneDate}{2}{MidtermTwoDate}{3}{MidtermThreeDate}}}
\cs_new_protected:Npn \mhsyllabus_collect_schedule_date:
  {
    \mhsemester_effective_weekday_set:
    \int_compare:nNnT {\l_mhsemester_effective_weekday_int} > {-1}
      {
        \mhsyllabus_daycode_matches:nnT
          {\LectureDays}{\l_mhsemester_effective_weekday_int}
          {
            \int_gincr:N \l_mhsyllabus_lecture_index_int
            \int_set:Nn \l_mhsyllabus_topic_index_int
              {\mhsyllabus_topic_index_for_meeting:n {\l_mhsyllabus_lecture_index_int}}
            \prop_map_inline:Nn \g_mhsyllabus_midterm_topics_prop
              {
                \int_compare:nNnT {\l_mhsyllabus_topic_index_int} = {##2}
                  {
                    \cs_gset:cpx {\mhsyllabus_midterm_date_cs:n {##1}}
                      {\mhsyllabus_format_current_date:}
                  }
              }
            \int_compare:nNnT {\l_mhsyllabus_topic_index_int}
              > {\seq_count:N \g_mhsyllabus_topic_labels_seq}
              {
                \msg_warning:nnx {mh-syllabus}{unassigned-meeting}
                  {\int_use:N \l_mhsyllabus_lecture_index_int}
              }
            \seq_gput_right:Nx \l_mhsyllabus_schedule_seq
              {
                \exp_not:N \mhsyllabus_schedule_lecture:nn
                  {\mhsyllabus_format_current_date:}
                  {\int_use:N \l_mhsyllabus_topic_index_int}
              }
          }
        \bool_set_false:N \l_mhsyllabus_has_recitation_bool
        \seq_map_inline:Nn \g_mhsyllabus_recitation_daycodes_seq
          {
            \mhsyllabus_daycode_matches:nnT
              {##1}{\l_mhsemester_effective_weekday_int}
              {\bool_set_true:N \l_mhsyllabus_has_recitation_bool}
          }
        \bool_if:NT \l_mhsyllabus_has_recitation_bool
          {
            \int_gincr:N \l_mhsyllabus_recitation_index_int
            % Sections on different weekdays progress independently. Several
            % sections on one weekday still share one calendar/quiz row.
            \prop_get:NeNTF \g_mhsyllabus_recitation_counts_prop
              {\int_use:N \l_mhsemester_effective_weekday_int} \l_tmpa_tl
              {\int_set:Nn \l_mhsyllabus_recitation_group_index_int {\l_tmpa_tl+1}}
              {\int_set:Nn \l_mhsyllabus_recitation_group_index_int {1}}
            \prop_gput:Nxx \g_mhsyllabus_recitation_counts_prop
              {\int_use:N \l_mhsemester_effective_weekday_int}
              {\int_use:N \l_mhsyllabus_recitation_group_index_int}
            \seq_gput_right:Nx \l_mhsyllabus_schedule_seq
              {
                \exp_not:N \mhsyllabus_schedule_recitation:nn
                  {\mhsyllabus_format_current_date:}
                  {\int_use:N \l_mhsyllabus_recitation_group_index_int}
              }
          }
      }
  }
\cs_new_protected:Npn \mhsyllabus_schedule_lecture:nn #1#2
  {
    \int_compare:nNnTF {#2} > {\seq_count:N \g_mhsyllabus_topic_labels_seq}
      {#1 & -- & -- & \textbf{Topic~not~assigned;~review~pacing} \\}
      {
        #1
          & \seq_item:Nn \g_mhsyllabus_topic_labels_seq {#2}
          & \seq_item:Nn \g_mhsyllabus_topic_texts_seq {#2}
          & \seq_item:Nn \g_mhsyllabus_topic_titles_seq {#2} \\
        \int_compare:nNnT {\seq_item:Nn \g_mhsyllabus_topic_rules_seq {#2}} = {1}
          {\midrule}
      }
  }
\cs_new_protected:Npn \mhsyllabus_schedule_recitation:nn #1#2
  {
    #1 & \textit{Rec.} & --
      & \int_compare:nNnTF {#2} = {1}
          {\RecitationIntroduction}{Quiz~\int_eval:n {#2-1}} \\
  }
\cs_new_protected:Npn \mhsyllabus_build_schedule:
  {
    \bool_if:NF \g_mhsyllabus_schedule_built_bool
      {
        \mhsemester_require_range:
        \seq_gclear:N \l_mhsyllabus_schedule_seq
        \int_gzero:N \l_mhsyllabus_lecture_index_int
        \int_gzero:N \l_mhsyllabus_recitation_index_int
        \prop_gclear:N \g_mhsyllabus_recitation_counts_prop
        \cs_gset:Npn \MidtermOneDate {}
        \cs_gset:Npn \MidtermTwoDate {}
        \cs_gset:Npn \MidtermThreeDate {}
        \pgfcalendar{mhsyllabusschedule}
          {\c_mhsyllabus_semester_start_tl}{\c_mhsyllabus_semester_end_tl}
          {\mhsyllabus_collect_schedule_date:}
        \prop_map_inline:Nn \g_mhsyllabus_midterm_topics_prop
          {
            \exp_args:Nv \tl_if_empty:nT
              {\mhsyllabus_midterm_date_cs:n {##1}}
              {\msg_warning:nnn {mh-syllabus}{missing-midterm}{##1}}
          }
        \bool_gset_true:N \g_mhsyllabus_schedule_built_bool
      }
  }
\NewDocumentCommand{\BuildSyllabusSchedule}{}{\mhsyllabus_build_schedule:}


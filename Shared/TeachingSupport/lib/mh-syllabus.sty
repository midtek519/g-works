%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Standard Rutgers 80-minute periods
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\PeriodTime}[1]{%
  \ifcase#1\relax
    \PackageError{mh-syllabus}
      {Invalid class period `#1'}
      {Valid class periods are 1 through 8.}%
  \or 8:30--9:50\,am%
  \or 10:20--11:40\,am%
  \or 12:10--1:30\,pm%
  \or 2:00--3:20\,pm%
  \or 3:50--5:10\,pm%
  \or 5:40--7:00\,pm%
  \or 7:30--8:50\,pm%
  \or 9:20--10:40\,pm%
  \else
    \PackageError{mh-syllabus}
      {Unknown class period `#1'}
      {Valid class periods are 1 through 8.}%
  \fi
}


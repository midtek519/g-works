%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Recitations
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\seq_new:N \g_mhsyllabus_recitations_seq
\seq_new:N \g_mhsyllabus_recitation_daycodes_seq

\NewDocumentCommand{\AddRecitation}{mmmm}
  {
    \str_case:nnF {#2} {{M}{} {T}{} {W}{} {Th}{} {F}{}}
      {\msg_fatal:nnn {mh-semester}{invalid-day}{#2}}
    % Complete row for the meeting-times table.
    \seq_gput_right:Nn \g_mhsyllabus_recitations_seq
      {
        Section~#1
          & Recitation
          & #2#3
          & \PeriodTime{#3}
          & #4
          \\
      }

    % Each distinct recitation weekday is also used by the course calendar.
    \seq_if_in:NnF \g_mhsyllabus_recitation_daycodes_seq {#2}
      {
        \seq_gput_right:Nn
          \g_mhsyllabus_recitation_daycodes_seq
          {#2}
      }
    \mhsyllabus_invalidate_schedule:
  }

% Reset meetings before loading another course/section profile.
\NewDocumentCommand{\ClearSyllabusMeetings}{}
  {
    \seq_gclear:N \g_mhsyllabus_recitations_seq
    \seq_gclear:N \g_mhsyllabus_recitation_daycodes_seq
    \cs_gset:Npn \LectureSections {}
    \cs_gset:Npn \LectureDays {}
    \cs_gset:Npn \LecturePeriod {}
    \cs_gset:Npn \LectureRoom {}
    \cs_gset:Npn \mhLecturePeriodCombo {}
    \mhsyllabus_reset_final_exam:
    \mhsyllabus_invalidate_schedule:
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Day-code matching
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prg_new_conditional:Npnn
  \mhsyllabus_daycode_matches:nn #1#2
  {T,F,TF}
  {
    \str_case:enF {#1}
      {
        {M}
          {
            \int_compare:nNnTF {#2} = {0}
              {\prg_return_true:}
              {\prg_return_false:}
          }

        {T}
          {
            \int_compare:nNnTF {#2} = {1}
              {\prg_return_true:}
              {\prg_return_false:}
          }

        {W}
          {
            \int_compare:nNnTF {#2} = {2}
              {\prg_return_true:}
              {\prg_return_false:}
          }

        {Th}
          {
            \int_compare:nNnTF {#2} = {3}
              {\prg_return_true:}
              {\prg_return_false:}
          }

        {F}
          {
            \int_compare:nNnTF {#2} = {4}
              {\prg_return_true:}
              {\prg_return_false:}
          }

        {MW}
          {
            \int_compare:nNnTF {#2} = {0}
              {\prg_return_true:}
              {
                \int_compare:nNnTF {#2} = {2}
                  {\prg_return_true:}
                  {\prg_return_false:}
              }
          }

        {MT}
          {
            \int_compare:nNnTF {#2} = {0}
              {\prg_return_true:}
              {
                \int_compare:nNnTF {#2} = {1}
                  {\prg_return_true:}
                  {\prg_return_false:}
              }
          }

        {MTh}
          {
            \int_compare:nNnTF {#2} = {0}
              {\prg_return_true:}
              {
                \int_compare:nNnTF {#2} = {3}
                  {\prg_return_true:}
                  {\prg_return_false:}
              }
          }

        {MF}
          {
            \int_compare:nNnTF {#2} = {0}
              {\prg_return_true:}
              {
                \int_compare:nNnTF {#2} = {4}
                  {\prg_return_true:}
                  {\prg_return_false:}
              }
          }

        {TW}
          {
            \int_compare:nNnTF {#2} = {1}
              {\prg_return_true:}
              {
                \int_compare:nNnTF {#2} = {2}
                  {\prg_return_true:}
                  {\prg_return_false:}
              }
          }

        {TTh}
          {
            \int_compare:nNnTF {#2} = {1}
              {\prg_return_true:}
              {
                \int_compare:nNnTF {#2} = {3}
                  {\prg_return_true:}
                  {\prg_return_false:}
              }
          }

        {TF}
          {
            \int_compare:nNnTF {#2} = {1}
              {\prg_return_true:}
              {
                \int_compare:nNnTF {#2} = {4}
                  {\prg_return_true:}
                  {\prg_return_false:}
              }
          }

        {WTh}
          {
            \int_compare:nNnTF {#2} = {2}
              {\prg_return_true:}
              {
                \int_compare:nNnTF {#2} = {3}
                  {\prg_return_true:}
                  {\prg_return_false:}
              }
          }

        {WF}
          {
            \int_compare:nNnTF {#2} = {2}
              {\prg_return_true:}
              {
                \int_compare:nNnTF {#2} = {4}
                  {\prg_return_true:}
                  {\prg_return_false:}
              }
          }

        {ThF}
          {
            \int_compare:nNnTF {#2} = {3}
              {\prg_return_true:}
              {
                \int_compare:nNnTF {#2} = {4}
                  {\prg_return_true:}
                  {\prg_return_false:}
              }
          }
      }
      {
        \PackageError{mh-syllabus}
          {Unknown meeting-day code `#1'}
          {Use a supported code such as MTh, TTh, MW, F, etc.}
        \prg_return_false:
      }
  }


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Special lecture period combinations
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\mhLecturePeriodCombo}{}

\newcommand{\LecturePeriodCombo}[1]{%
  \def\mhLecturePeriodCombo{#1}%
  \ifdefstring{\mhLecturePeriodCombo}{W2F5}
    {}
    {%
      \ifdefstring{\mhLecturePeriodCombo}{W3F4}
        {}
        {%
          \PackageError{mh-syllabus}
            {Unknown lecture period combination '#1'}
            {Valid combinations are W2F5 and W3F4.}%
        }%
    }%
  \renewcommand{\LectureDays}{WF}%
  \InvalidateSyllabusSchedule
}

\newcommand{\IfLecturePeriodComboTF}[2]{%
  \ifdefempty{\mhLecturePeriodCombo}
    {#2}
    {#1}%
}

\newcommand{\LecturePeriodDisplay}{%
  \IfLecturePeriodComboTF
    {%
      \ifdefstring{\mhLecturePeriodCombo}{W2F5}
        {W2 / F5}
        {W3 / F4}%
    }
    {%
      % Existing ordinary lecture-period display goes here.
      \LectureDays\LecturePeriod
    }%
}

\newcommand{\LectureTimeDisplay}{%
  \IfLecturePeriodComboTF
    {%
      \ifdefstring{\mhLecturePeriodCombo}{W2F5}
        {W2: \PeriodTime{2}; F5: \PeriodTime{5}}
        {W3: \PeriodTime{3}; F4: \PeriodTime{4}}%
    }
    {%
      \PeriodTime{\LecturePeriod}%
    }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Final exam information
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\FinalExamDate}{}
\newcommand{\FinalExamTime}{}

\ExplSyntaxOn
\bool_new:N \g_mhsyllabus_final_date_explicit_bool
\bool_new:N \g_mhsyllabus_final_time_explicit_bool
\seq_new:N \l_mhsyllabus_final_date_parts_seq

% This is an authoring default, not an official course exam assignment.
% Explicit setters (including TBA or an intentionally blank value) take priority.
\cs_new_protected:Npn \mhsyllabus_final_defaults_apply:
  {
    \bool_if:NF \g_mhsyllabus_final_date_explicit_bool
      {
        \tl_if_empty:oTF {\SemesterExamFirstDate}
          {\cs_gset:Npn \FinalExamDate {}}
          {
            % Match the calendar's month/day style; the semester header gives
            % the year. The full-date getters remain available for other uses.
            \seq_set_split:NnV \l_mhsyllabus_final_date_parts_seq {-}
              \SemesterExamFirstDate
            \cs_gset:Npx \FinalExamDate
              {
                \mhsyllabus_month_name:n
                  {\seq_item:Nn \l_mhsyllabus_final_date_parts_seq {2}}
                \exp_not:N \nobreakspace
                \int_eval:n
                  {\seq_item:Nn \l_mhsyllabus_final_date_parts_seq {3}}
              }
          }
      }
    \bool_if:NF \g_mhsyllabus_final_time_explicit_bool
      {
        \tl_if_empty:oTF {\SemesterExamFirstDate}
          {\cs_gset:Npn \FinalExamTime {}}
          {\cs_gset:Npn \FinalExamTime {12:00--3:00\,pm}}
      }
  }

\cs_new_protected:Npn \mhsyllabus_reset_final_exam:
  {
    \bool_gset_false:N \g_mhsyllabus_final_date_explicit_bool
    \bool_gset_false:N \g_mhsyllabus_final_time_explicit_bool
    \mhsyllabus_final_defaults_apply:
  }

\NewDocumentCommand{\SetFinalExamDate}{m}
  {
    \bool_gset_true:N \g_mhsyllabus_final_date_explicit_bool
    \cs_gset:Npn \FinalExamDate {#1}
  }

\NewDocumentCommand{\SetFinalExamTime}{m}
  {
    \bool_gset_true:N \g_mhsyllabus_final_time_explicit_bool
    \cs_gset:Npn \FinalExamTime {#1}
  }
\ExplSyntaxOff


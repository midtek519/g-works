\newcommand{\QuizFrontMatter}{%
  \IfMathAssessmentT{%
    \IfMathStudentT{%

      % Instructions
      \vspace*{-12mm}
      \begin{center}
        \fbox{%
          \begin{minipage}{0.92\linewidth}
            \small
            \textbf{\underline{Instructions:}}
            \begin{itemize}[
              topsep=0pt,
              itemsep=0pt,
            ]
              \item Answer the questions in the spaces provided and show all of your work.
              \item Responses with no work may receive no credit even if the answer is correct.
            \end{itemize}
          \end{minipage}%
        }%
      \end{center}%

      \vspace{0.5em}%

      % Student information
      \noindent
      \begin{tabularx}{\linewidth}
        {@{}l X @{\hspace{2em}} l p{0.24\linewidth}@{}}
        Name: & \hrulefill
          & netID: & \hrulefill
      \end{tabularx}%

      \par

    }%
  }%
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Course description
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\SyllabusCourseDescription}{%
  \SyllabusItem{Course\\Description}{%
    Welcome to Math 152! This course is a continuation of Math 151, and is part of the three-semester calculus sequence for the mathematical and physical sciences. We will start by building on the ideas of Calculus I to further study integral calculus and its applications. We will then learn about the theory and applications of infinite series and power series. Finally, we will explore calculus in other coordinate systems (parametric, polar) and complex numbers.
  }%
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Course learning goals
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\SyllabusLearningGoals}{%
  \SyllabusItem{Course\\Learning\\Goals}{%
    By the end of this course, learners will be able to:
    \begin{enumerate}[label=\textbf{[\arabic*]},topsep=2pt,itemsep=-1ex,partopsep=1ex,parsep=1ex]
        \item Use integrals to solve application problems, e.g., volumes, surface area, and arc length.
        \item Use various techniques for finding antiderivatives, including integration by parts, and trigonometric substitution.
        \item Determine the convergence or divergence of sequences and series, using tests such as the integral test, the $n$th term test, comparison tests, the alternating series test, and the ratio and root test.
        \item Represent functions using their Taylor and Maclaurin polynomials and series, and to integrate and differentiate those polynomials and series.
        \item Solve problems using parametric equations and polar forms.
        \item Learn polar and exponential form of complex numbers, and applications of complex numbers.
    \end{enumerate}
  }%
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Topic registry
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_mh_topic_title_prop
\prop_new:N \g_mh_topic_short_title_prop
\prop_new:N \g_mh_topic_section_prop
\prop_new:N \g_mh_topic_order_prop
\seq_new:N \g_mh_topics_seq

\tl_new:N  \l_mh_topic_title_tl
\tl_new:N  \l_mh_topic_short_title_tl
\tl_new:N  \l_mh_topic_section_tl
\int_new:N \l_mh_topic_order_int

\keys_define:nn { mh / topic }
  {
    title .tl_set:N =
      \l_mh_topic_title_tl,

    short-title .tl_set:N =
      \l_mh_topic_short_title_tl,

    section .tl_set:N =
      \l_mh_topic_section_tl,

    order .int_set:N =
      \l_mh_topic_order_int,

    title .value_required:n = true,
    section .value_required:n = true
  }

\cs_new_protected:Npn \mh_topic_declare:nn #1#2
  {
    \prop_if_in:NnTF \g_mh_topic_title_prop {#1}
      {
        \msg_error:nnn { mh } { duplicate-topic } {#1}
      }
      {
        \tl_clear:N \l_mh_topic_title_tl
        \tl_clear:N \l_mh_topic_short_title_tl
        \tl_clear:N \l_mh_topic_section_tl
        \int_zero:N \l_mh_topic_order_int

        \keys_set:nn { mh / topic } {#2}

        \tl_if_blank:VTF \l_mh_topic_short_title_tl
          {
            \tl_set_eq:NN
              \l_mh_topic_short_title_tl
              \l_mh_topic_title_tl
          }
          { }

        \prop_gput:NnV
          \g_mh_topic_title_prop
          {#1}
          \l_mh_topic_title_tl

        \prop_gput:NnV
          \g_mh_topic_short_title_prop
          {#1}
          \l_mh_topic_short_title_tl

        \prop_gput:NnV
          \g_mh_topic_section_prop
          {#1}
          \l_mh_topic_section_tl

        \prop_gput:Nnx
          \g_mh_topic_order_prop
          {#1}
          { \int_use:N \l_mh_topic_order_int }

        \seq_gput_right:Nn
          \g_mh_topics_seq
          {#1}
      }
  }

\prg_new_conditional:Npnn \mh_topic_if_exist:n #1 { T, F, TF }
  {
    \prop_if_in:NnTF \g_mh_topic_title_prop {#1}
      { \prg_return_true: }
      { \prg_return_false: }
  }

% Variant used when the topic identifier is stored in a token-list variable.
\prg_generate_conditional_variant:Nnn
  \mh_topic_if_exist:n
  { V }
  { T, F, TF }

\cs_new:Npn \mh_topic_title:n #1
  {
    \prop_item:Nn \g_mh_topic_title_prop {#1}
  }

\cs_new:Npn \mh_topic_short_title:n #1
  {
    \prop_item:Nn \g_mh_topic_short_title_prop {#1}
  }

\cs_new:Npn \mh_topic_section:n #1
  {
    \prop_item:Nn \g_mh_topic_section_prop {#1}
  }

\cs_new:Npn \mh_topic_label:n #1
  {
    \tl_if_blank:eTF
      {
        \prop_item:Nn
          \g_mh_topic_section_prop
          {#1}
      }
      {
        % No section
        \prop_item:Nn
          \g_mh_topic_title_prop
          {#1}
      }
      {
        % Has section
        \S
        \prop_item:Nn
          \g_mh_topic_section_prop
          {#1}
        \c_space_tl
        \prop_item:Nn
          \g_mh_topic_title_prop
          {#1}
      }
  }

\seq_new:N \l_mh_topics_seq
\int_new:N \l_mh_topic_index_int

\cs_new_protected:Npn \mh_topics_labels:n #1
  {
    \group_begin:

      % Store the supplied topic identifiers as a sequence.
      \seq_set_from_clist:Nn
        \l_mh_topics_seq
        {#1}

      % Validate all identifiers before attempting to sort them.
      \seq_map_inline:Nn
        \l_mh_topics_seq
        {
          \mh_topic_if_exist:nF {##1}
            {
              \msg_error:nnn
                { mh }
                { unknown-topic }
                {##1}
            }
        }

      % Sort according to the canonical order stored in the registry.
      \seq_sort:Nn
        \l_mh_topics_seq
        {
          \int_compare:nNnTF
            {
              \prop_item:Nn
                \g_mh_topic_order_prop
                {##1}
            }
            >
            {
              \prop_item:Nn
                \g_mh_topic_order_prop
                {##2}
            }
            { \sort_return_swapped: }
            { \sort_return_same: }
        }

      % Print the sorted topic labels.
      \int_zero:N \l_mh_topic_index_int

      \seq_map_inline:Nn
        \l_mh_topics_seq
        {
          \int_incr:N \l_mh_topic_index_int

          \int_compare:nNnT
            { \l_mh_topic_index_int }
            >
            { 1 }
            {
              \c_space_tl
              \textperiodcentered
              \c_space_tl
            }

          \mh_topic_label:n {##1}
        }

    \group_end:
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Objective registry
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_mh_objective_topic_prop
\prop_new:N \g_mh_objective_short_prop
\prop_new:N \g_mh_objective_long_prop
\seq_new:N \g_mh_objectives_seq

\tl_new:N \l_mh_objective_topic_tl
\tl_new:N \l_mh_objective_short_tl
\tl_new:N \l_mh_objective_long_tl

\keys_define:nn { mh / objective }
  {
    topic .tl_set:N =
      \l_mh_objective_topic_tl,

    description .tl_set:N =
      \l_mh_objective_short_tl,

    short .tl_set:N =
      \l_mh_objective_short_tl,

    long .tl_set:N =
      \l_mh_objective_long_tl,

    topic .value_required:n = true,
    short .value_required:n = true
  }

\cs_new_protected:Npn \mh_objective_declare:nn #1#2
  {
    \prop_if_in:NnTF \g_mh_objective_short_prop {#1}
      {
        \msg_error:nnn { mh } { duplicate-objective } {#1}
      }
      {
        \tl_clear:N \l_mh_objective_topic_tl
        \tl_clear:N \l_mh_objective_short_tl
        \tl_clear:N \l_mh_objective_long_tl

        \keys_set:nn { mh / objective } {#2}

        % Universal objectives describe the task independently of a course.
        % Preserve validation when older sources explicitly associate a topic.
        \tl_if_blank:VF \l_mh_objective_topic_tl
          {
            \mh_topic_if_exist:VF
              \l_mh_objective_topic_tl
              {
                \msg_error:nnx
                  { mh }
                  { unknown-topic }
                  { \tl_use:N \l_mh_objective_topic_tl }
              }
          }

        \tl_if_blank:VTF \l_mh_objective_long_tl
          {
            \tl_set_eq:NN
              \l_mh_objective_long_tl
              \l_mh_objective_short_tl
          }
          { }

        \prop_gput:NnV
          \g_mh_objective_topic_prop
          {#1}
          \l_mh_objective_topic_tl

        \prop_gput:NnV
          \g_mh_objective_short_prop
          {#1}
          \l_mh_objective_short_tl

        \prop_gput:NnV
          \g_mh_objective_long_prop
          {#1}
          \l_mh_objective_long_tl

        \seq_gput_right:Nn
          \g_mh_objectives_seq
          {#1}
      }
  }

\prg_new_conditional:Npnn \mh_objective_if_exist:n #1 { T, F, TF }
  {
    \prop_if_in:NnTF \g_mh_objective_short_prop {#1}
      { \prg_return_true: }
      { \prg_return_false: }
  }

\cs_new:Npn \mh_objective_short:n #1
  {
    \mh_objective_if_exist:nTF {#1}
      {
        \prop_item:Nn \g_mh_objective_short_prop {#1}
      }
      {
        \msg_error:nnn { mh } { unknown-objective } {#1}
      }
  }

\cs_new:Npn \mh_objective_long:n #1
  {
    \mh_objective_if_exist:nTF {#1}
      {
        \prop_item:Nn \g_mh_objective_long_prop {#1}
      }
      {
        \msg_error:nnn { mh } { unknown-objective } {#1}
      }
  }

\clist_new:N \l_mh_objectives_clist
\int_new:N \l_mh_objective_index_int

\cs_new_protected:Npn \mh_objectives_short:n #1
  {
    \group_begin:
      \clist_set:Nn \l_mh_objectives_clist {#1}
      \int_zero:N \l_mh_objective_index_int

      \clist_map_inline:Nn
        \l_mh_objectives_clist
        {
          \int_incr:N \l_mh_objective_index_int

          \int_compare:nNnT
            { \l_mh_objective_index_int }
            >
            { 1 }
            {
              ;\c_space_tl
            }

          \mh_objective_short:n {##1}
        }
    \group_end:
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Controlled metadata registries
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\prop_new:N \g_mh_type_prop
\prop_new:N \g_mh_trait_prop
\prop_new:N \g_mh_level_prop
\prop_new:N \g_mh_status_prop

\cs_new_protected:Npn \mh_metadata_declare:nnn #1#2#3
  {
    \prop_if_in:cnTF
      { g_mh_#1_prop }
      {#2}
      {
        \msg_error:nnnn
          { mh }
          { duplicate-metadata }
          {#1}
          {#2}
      }
      {
        \prop_gput:cnn
          { g_mh_#1_prop }
          {#2}
          {#3}
      }
  }

\prg_new_conditional:Npnn \mh_metadata_if_exist:nn #1#2
  { T, F, TF }
  {
    \prop_if_in:cnTF
      { g_mh_#1_prop }
      {#2}
      { \prg_return_true: }
      { \prg_return_false: }
  }

\cs_new:Npn \mh_metadata_label:nn #1#2
  {
    \mh_metadata_if_exist:nnTF {#1} {#2}
      {
        \prop_item:cn
          { g_mh_#1_prop }
          {#2}
      }
      {
        \msg_error:nnnn
          { mh }
          { unknown-metadata }
          {#1}
          {#2}
      }
  }

\clist_new:N \l_mh_metadata_clist
\int_new:N \l_mh_metadata_index_int

\cs_new_protected:Npn \mh_metadata_labels:nn #1#2
  {
    \group_begin:
      \clist_set:Nn \l_mh_metadata_clist {#2}
      \int_zero:N \l_mh_metadata_index_int

      \clist_map_inline:Nn
        \l_mh_metadata_clist
        {
          \int_incr:N \l_mh_metadata_index_int

          \int_compare:nNnT
            { \l_mh_metadata_index_int }
            >
            { 1 }
            {
              \c_space_tl
              \textperiodcentered
              \c_space_tl
            }

          \mh_metadata_label:nn {#1} {##1}
        }
    \group_end:
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Exercise identifier formatting
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \l_mh_exercise_id_tl
\seq_new:N \l_mh_exercise_id_parts_seq

\cs_new_protected:Npn \mh_exercise_number:n #1
  {
    \group_begin:
      \tl_set:Ne \l_mh_exercise_id_tl {#1}

      \seq_set_split:NnV
        \l_mh_exercise_id_parts_seq
        { - }
        \l_mh_exercise_id_tl

      \int_eval:n
        {
          \seq_item:Nn
            \l_mh_exercise_id_parts_seq
            { -1 }
        }
    \group_end:
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Exercise registry
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\seq_new:N \g_mh_exercises_seq

\prop_new:N \g_mh_exercise_topics_prop
\prop_new:N \g_mh_exercise_objectives_prop
\prop_new:N \g_mh_exercise_type_prop
\prop_new:N \g_mh_exercise_traits_prop
\prop_new:N \g_mh_exercise_level_prop
\prop_new:N \g_mh_exercise_sets_prop
\prop_new:N \g_mh_exercise_status_prop

% Missing metadata is allowed for ad hoc coursework. Validate every supplied
% controlled value, even if the current output template does not display it.
% `sets` remains an author-defined collection label rather than a vocabulary.
\cs_new_protected:Npn \mh_exercise_validate:nnnn #1#2#3#4
  {
    \clist_map_inline:nn {#4}
      {
        \prop_if_in:cnF {#3} {##1}
          {
            \msg_error:nnnnn { mh } { invalid-exercise-value }
              {#1} {#2} {##1}
          }
      }
  }

\cs_new_protected:Npn \mh_exercise_compare:nnn #1#2#3
  {
    \prop_get:cnN { g_mh_exercise_#2_prop } {#1} \l_tmpa_tl
    \tl_if_eq:NnF \l_tmpa_tl {#3}
      {
        \msg_warning:nnnn { mh } { conflicting-exercise-id } {#1} {#2}
      }
  }

\cs_new_protected:Npn \mh_exercise_register:nnnnnnnn #1#2#3#4#5#6#7#8
  {
    \mh_exercise_validate:nnnn {#1} {topics}
      {g_mh_topic_title_prop} {#2}
    \mh_exercise_validate:nnnn {#1} {objectives}
      {g_mh_objective_short_prop} {#3}
    \mh_exercise_validate:nnnn {#1} {type}
      {g_mh_type_prop} {#4}
    \mh_exercise_validate:nnnn {#1} {traits}
      {g_mh_trait_prop} {#5}
    \mh_exercise_validate:nnnn {#1} {level}
      {g_mh_level_prop} {#6}
    \mh_exercise_validate:nnnn {#1} {status}
      {g_mh_status_prop} {#8}

    % Repeated use of an unchanged exercise is permitted. Conflicting metadata
    % must be visible rather than being silently discarded from the registry.
    \seq_if_in:NnTF
      \g_mh_exercises_seq
      {#1}
      {
        \mh_exercise_compare:nnn {#1} {topics} {#2}
        \mh_exercise_compare:nnn {#1} {objectives} {#3}
        \mh_exercise_compare:nnn {#1} {type} {#4}
        \mh_exercise_compare:nnn {#1} {traits} {#5}
        \mh_exercise_compare:nnn {#1} {level} {#6}
        \mh_exercise_compare:nnn {#1} {sets} {#7}
        \mh_exercise_compare:nnn {#1} {status} {#8}
      }
      {
        \seq_gput_right:Nn
          \g_mh_exercises_seq
          {#1}

        \prop_gput:Nnn
          \g_mh_exercise_topics_prop
          {#1}
          {#2}

        \prop_gput:Nnn
          \g_mh_exercise_objectives_prop
          {#1}
          {#3}

        \prop_gput:Nnn
          \g_mh_exercise_type_prop
          {#1}
          {#4}

        \prop_gput:Nnn
          \g_mh_exercise_traits_prop
          {#1}
          {#5}

        \prop_gput:Nnn
          \g_mh_exercise_level_prop
          {#1}
          {#6}

        \prop_gput:Nnn
          \g_mh_exercise_sets_prop
          {#1}
          {#7}

        \prop_gput:Nnn
          \g_mh_exercise_status_prop
          {#1}
          {#8}
      }
  }

\cs_generate_variant:Nn
  \mh_exercise_register:nnnnnnnn
  { eeeeeeee }


\ProvidesExplPackage
  {mh}
  {2026-10-12}
  {0.6.0}
  {Core engine for the MathHouse exercise database}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Purpose
%
% This package provides the public interface and central engine for the
% MathHouse exercise database.
%
% It defines the machinery used by curriculum and metadata files but
% contains no course-specific declarations.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{xsim}
\RequirePackage{mh-colors}
\RequirePackage{mh-utilities}
\RequirePackage{l3keys2e}

\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Large-bank auxiliary output
%
% XSIM serializes each property, including all exercise/solution bodies,
% as one physical line. A full bank can exceed TeX's default input buffer.
% Wrap at existing spaces without expanding body macros or changing XSIM's
% capture mode. Both the normal .xsim file and use-aux mode are supported.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_eq:NN \mh_xsim_write_aux_unwrapped:n \xsim_write_to_aux:n
\cs_set_protected:Npn \xsim_write_to_aux:n #1
  {
    \iow_wrap:nnnN
      { \tl_to_str:n {#1} }
      { }
      { \int_set:Nn \l_iow_line_count_int { 1000 } }
      \mh_xsim_write_aux_unwrapped:n
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Messages
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\msg_new:nnn { mh } { duplicate-topic }
  {
    The~topic~'#1'~has~already~been~declared.
  }

\msg_new:nnn { mh } { unknown-topic }
  {
    The~topic~'#1'~has~not~been~declared.
  }

\msg_new:nnn { mh } { duplicate-objective }
  {
    The~objective~'#1'~has~already~been~declared.
  }

\msg_new:nnn { mh } { unknown-objective }
  {
    The~objective~'#1'~has~not~been~declared.
  }

\msg_new:nnn { mh } { duplicate-metadata }
  {
    The~#1~identifier~'#2'~has~already~been~declared.
  }

\msg_new:nnn { mh } { unknown-metadata }
  {
    The~#1~identifier~'#2'~has~not~been~declared.
  }

\msg_new:nnn { mh } { invalid-exercise-value }
  {
    Exercise~'#1'~has~undeclared~#2~value~'#3'.~Load~the
    ~appropriate~declarations~or~correct~the~value.
  }

\msg_new:nnn { mh } { conflicting-exercise-id }
  {
    Exercise~ID~'#1'~was~reused~with~different~#2~metadata.~The
    ~registry~retains~the~first~record;~review~this~reuse.
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Package options
%%
%% The framework has three independent axes:
%%
%%   document type:   document / manual / assessment / worksheet
%%   output mode:     student / solutions / developer
%%   accessibility:   standard / accessible
%%
%% Defaults:
%%
%%   document, student, standard
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \g_mh_document_type_tl
\tl_new:N \g_mh_mode_tl
\tl_new:N \g_mh_accessibility_tl

\bool_new:N \g_mh_print_solutions_bool
\bool_new:N \g_mh_developer_mode_bool
\bool_new:N \g_mh_accessible_mode_bool

% Convenience state for document-type tests.
\bool_new:N \g_mh_document_bool
\bool_new:N \g_mh_manual_bool
\bool_new:N \g_mh_assessment_bool
\bool_new:N \g_mh_worksheet_bool

% Defaults when no package options are supplied.
\tl_gset:Nn \g_mh_document_type_tl { document }
\tl_gset:Nn \g_mh_mode_tl          { student }
\tl_gset:Nn \g_mh_accessibility_tl { standard }

\keys_define:nn { mh / package }
  {
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    % Document type
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

    type .choice:,

    type / document .code:n =
      {
        \tl_gset:Nn \g_mh_document_type_tl { document }
      },

    type / manual .code:n =
      {
        \tl_gset:Nn \g_mh_document_type_tl { manual }
      },

    type / assessment .code:n =
      {
        \tl_gset:Nn \g_mh_document_type_tl { assessment }
      },

    type / worksheet .code:n =
      {
        \tl_gset:Nn \g_mh_document_type_tl { worksheet }
      },

    document .meta:n =
      { type = document },

    manual .meta:n =
      { type = manual },

    assessment .meta:n =
      { type = assessment },

    worksheet .meta:n =
      { type = worksheet },

    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    % Output mode
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

    mode .choice:,

    mode / student .code:n =
      {
        \tl_gset:Nn \g_mh_mode_tl { student }
      },

    mode / solutions .code:n =
      {
        \tl_gset:Nn \g_mh_mode_tl { solutions }
      },

    mode / developer .code:n =
      {
        \tl_gset:Nn \g_mh_mode_tl { developer }
      },

    student .meta:n =
      { mode = student },

    solutions .meta:n =
      { mode = solutions },

    developer .meta:n =
      { mode = developer },

    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    % Accessibility
    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

    accessibility .choice:,

    accessibility / standard .code:n =
      {
        \tl_gset:Nn \g_mh_accessibility_tl { standard }
      },

    accessibility / accessible .code:n =
      {
        \tl_gset:Nn \g_mh_accessibility_tl { accessible }
      },

    standard .meta:n =
      { accessibility = standard },

    accessible .meta:n =
      { accessibility = accessible },
  }

\ProcessKeysOptions{mh / package}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Document-type initialization
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \mh_document_type_initialize:
  {
    \bool_gset_false:N \g_mh_document_bool
    \bool_gset_false:N \g_mh_manual_bool
    \bool_gset_false:N \g_mh_assessment_bool
    \bool_gset_false:N \g_mh_worksheet_bool

    \str_case:VnF \g_mh_document_type_tl
      {
        { document }
          {
            \bool_gset_true:N \g_mh_document_bool
          }

        { manual }
          {
            \bool_gset_true:N \g_mh_manual_bool
          }

        { assessment }
          {
            \bool_gset_true:N \g_mh_assessment_bool
          }

        { worksheet }
          {
            \bool_gset_true:N \g_mh_worksheet_bool
          }
      }
      {
        % Controlled options should make this unreachable.
        \tl_gset:Nn \g_mh_document_type_tl { document }
        \bool_gset_true:N \g_mh_document_bool
      }
  }

\mh_document_type_initialize:

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Output-mode initialization
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \mh_mode_initialize:
  {
    \bool_gset_false:N \g_mh_print_solutions_bool
    \bool_gset_false:N \g_mh_developer_mode_bool

    \str_case:VnF \g_mh_mode_tl
      {
        { student }
          {
            \bool_gset_false:N
              \g_mh_print_solutions_bool
          }

        { solutions }
          {
            \bool_gset_true:N
              \g_mh_print_solutions_bool
          }

        { developer }
          {
            \bool_gset_true:N
              \g_mh_print_solutions_bool

            \bool_gset_true:N
              \g_mh_developer_mode_bool
          }
      }
      {
        % Controlled options should make this unreachable.
        \tl_gset:Nn \g_mh_mode_tl { student }
      }

    \bool_if:NTF \g_mh_print_solutions_bool
      {
        \xsimsetup
          {
            solution / print = true
          }
      }
      {
        \xsimsetup
          {
            solution / print = false
          }
      }
  }

\mh_mode_initialize:

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Accessibility initialization
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\bool_gset_false:N \g_mh_accessible_mode_bool

\tl_if_eq:NnT \g_mh_accessibility_tl { accessible }
  {
    \bool_gset_true:N \g_mh_accessible_mode_bool
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Layout selection
%%
%% Each document type passes its corresponding layout mode to mh-layout.

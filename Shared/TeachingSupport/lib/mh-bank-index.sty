%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Printable topic coverage report
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\cs_new_protected:Npn \mh_print_topic_coverage:
  {
    \mh_compute_topic_coverage:
    \mh_reference_topics_sort:

    \begin{longtable}
      {
        >{\ttfamily\raggedright\arraybackslash}p{0.58\linewidth}
        >{\raggedleft\arraybackslash}p{0.14\linewidth}
        >{\raggedleft\arraybackslash}p{0.14\linewidth}
      }


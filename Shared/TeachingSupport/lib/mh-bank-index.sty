        &
      \normalfont\bfseries Exercises
        &
      \normalfont\bfseries Approved
      \\
      \midrule
      \endfirsthead

      \toprule
      \normalfont\bfseries Topic
        &
      \normalfont\bfseries Exercises
        &
      \normalfont\bfseries Approved
      \\
      \midrule
      \endhead

      \bottomrule
      \endfoot

      \seq_map_inline:Nn
        \l_mh_reference_topics_seq
        {
          ##1
            &
          \normalfont
          \prop_item:Nn
            \l_mh_topic_counts_prop
            {##1}
            &
          \normalfont
          \prop_item:Nn
            \l_mh_topic_approved_counts_prop
            {##1}
          \\
        }

    \end{longtable}
  }
  

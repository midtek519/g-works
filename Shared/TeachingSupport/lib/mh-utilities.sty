\NewDocumentCommand{\fillblank}{ O{0.8cm} m }{%
  \raisebox{-0.5\height+0.5ex}{%
    \fbox{%
      \rule{0pt}{#1}%
      \makebox[#2]{}%
    }%
  }%
}

\NewDocumentCommand{\blankaxes}{ O{} m m m m }{%
  \begin{cta}{Blank coordinate axes for sketching a graph.}[
    xmin=#2,
    xmax=#3,
    ymin=#4,
    ymax=#5,
    #1
  ]
  \end{cta}%
}


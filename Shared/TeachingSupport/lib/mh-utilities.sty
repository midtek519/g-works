%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Averaged integrals        %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\def\Xint#1{%
  \mathchoice
    {\XXint\displaystyle\textstyle{#1}}
    {\XXint\textstyle\scriptstyle{#1}}
    {\XXint\scriptstyle\scriptscriptstyle{#1}}
    {\XXint\scriptscriptstyle\scriptscriptstyle{#1}}
  \!\int
}

\def\XXint#1#2#3{%
  {%
    \setbox0=\hbox{$#1{#2#3}{\int}$}%
    \vcenter{\hbox{$#2#3$}}%
    \kern-.5\wd0
  }%
}

\def\ddashint{\Xint=}
\def\dashint{\Xint-}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% PGFPlots defaults         %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\pgfplotsset{
  every axis/.style={
    axis lines=center,
    thick,
    grid=major,
    axis equal image=true,
    trig format=rad,
    xlabel=\empty,
    ylabel=\empty,
    label style={font=\small},
    tick label style={font=\small},
    restrict x to domain=xmin:xmax,
    restrict y to domain=ymin:ymax,
    xtick distance=1,
    ytick distance=1,
    cycle list={{}},
  },
  every axis plot/.style={
    very thick,
    blue,
    smooth,
    no marks
  },
  soldot/.style={
    only marks,
    mark=*
  },
  holdot/.style={
    only marks,
    mark=*,
    fill=white
  },
  layers/shaded graph/.define layer set={
    axis background,
    pre main,
    axis grid,
    axis ticks,
    axis lines,
    axis tick labels,
    main,
    axis descriptions,
    axis foreground
  }{
    /pgfplots/layers/standard
  }
}

\tikzset{
  graph/.style={
    very thick,
    blue
  }
}

\newcommand{\xm}{\pgfkeysvalueof{/pgfplots/xmin}}
\newcommand{\xM}{\pgfkeysvalueof{/pgfplots/xmax}}
\newcommand{\ym}{\pgfkeysvalueof{/pgfplots/ymin}}
\newcommand{\yM}{\pgfkeysvalueof{/pgfplots/ymax}}


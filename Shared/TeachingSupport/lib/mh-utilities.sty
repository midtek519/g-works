%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% Plot environments         %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NewDocumentEnvironment{cta}{ m O{} }
  {%
    \begin{center}
    \begin{tikzpicture}[alt={#1}]
    \begin{axis}[#2]
  }
  {%
    \end{axis}
    \end{tikzpicture}
    \end{center}
  }

\NewDocumentEnvironment{ctatikz}{ m O{} }
  {%
    \begin{center}
    \begin{tikzpicture}[alt={#1},#2]
  }
  {%
    \end{tikzpicture}
    \end{center}
  }


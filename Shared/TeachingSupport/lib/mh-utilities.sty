\newcommand{\bnab}{\bm{\nabla}}
\newcommand{\bi}{\bm{i}}
\newcommand{\bj}{\bm{j}}
\newcommand{\bk}{\bm{k}}

\newcommand{\detcross}[7]{%
  \left|
    \begin{array}{#1}
      \bi & \bj & \bk \\
      #2  & #3  & #4 \\
      #5  & #6  & #7
    \end{array}
  \right|
}

\newcommand{\lang}{\left\langle}
\newcommand{\rang}{\right\rangle}


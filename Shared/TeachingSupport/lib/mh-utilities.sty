%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% General utilities         %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Center a single table cell
\newcommand{\mc}[1]{\multicolumn{1}{c}{#1}}

% Decimal-aligned table column
\newcolumntype{d}[1]{D{.}{.}{#1}}

% Apply a style to a table row
\newcommand{\setrow}[1]{%
  \gdef\rowmac{#1}#1\ignorespaces
}

\newcommand{\clearrow}{%
  \global\let\rowmac\relax
}

% Vertical spacing
\newcommand{\vi}{\vspace{0.15cm}}
\newcommand{\Vi}{\vspace{0.4cm}}

% Fill the current column and start the next
\newcommand{\nextcolumn}{%
  \vfill\null
  \columnbreak
}

% Box around short text
\newcommand{\widefbox}[1]{%
  \fbox{\hspace{1em}#1\hspace{1em}}%
}

% Rectangular label
\newcommand{\enrectangle}[1]{%
  \begin{tikzpicture}[baseline=(char.base)]
    \node[
      draw,
      fill=white,
      shape=rectangle,
      line width=0.3mm,
      minimum width=0.1cm
    ] (char) {\large\bfseries #1};
  \end{tikzpicture}%
}

% Circled label
\newcommand{\circled}[1]{%
  \tikz[baseline=(char.base)]{%
    \node[
      shape=circle,
      draw,
      inner sep=2pt
    ] (char) {#1};
  }%
}


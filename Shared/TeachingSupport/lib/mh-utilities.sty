\newcommand{\EvaluateLimits}{%
  For each part, evaluate the limit. Use $+\infty$ or $-\infty$ for an
  infinite limit and ``DNE'' otherwise if the limit does not exist.%
}

\newcommand{\TrueFalse}{%
  For each statement, fill in ``T'' if the statement is true or ``F'' if the statement is false.%
}

